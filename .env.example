# Copy the values you need into .env (MODEL_API_KEY) and .env.local (everything else). Never commit real values.
# Push them to the Cloudflare Worker with bot/scripts/push-secrets.sh (values are never printed).

# Meta Model API (Muse Spark, SAM 3.1, Muse Voice Transcribe, Muse Image) -> .env
MODEL_API_KEY=

# Meta webhooks (Messenger and WhatsApp) -> .env.local
VERIFY_TOKEN=
APP_SECRET=
WA_APP_SECRET=
PAGE_TOKEN=
WA_TOKEN=
WA_PHONE_ID=

# Telegram test channel -> .env.local
TG_TOKEN=

# Modal audio service (voice notes in, spoken replies out) -> .env.local
AUDIO_URL=
AUDIO_TOKEN=
